# Supabase project (Settings → API in the Supabase dashboard)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Never expose the service-role key to the browser — only use it in
# server-only code (Route Handlers, cron jobs), never in a NEXT_PUBLIC_ var.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Video streaming provider (e.g. Mux, Cloudflare Stream) — fill in once chosen
VIDEO_PROVIDER_API_KEY=
VIDEO_PROVIDER_WEBHOOK_SECRET=
